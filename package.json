{
  "name": "traceview-mindmap",
  "version": "1.0.1",
  "private": true,
  "description": "Edit Markdown notes as mind maps with keyboard navigation, persistent folds, linked nodes and ordered task planning.",
  "scripts": {
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test": "tsx --test tests/*.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^21.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "obsidian": "latest",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
